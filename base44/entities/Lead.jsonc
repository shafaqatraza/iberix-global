{
  "name": "Lead",
  "type": "object",
  "properties": {
    "company": {
      "type": "string",
      "title": "Company",
      "description": "Partner organization name"
    },
    "contact_name": {
      "type": "string",
      "title": "Contact Name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "Work Email"
    },
    "region": {
      "type": "string",
      "enum": [
        "APAC",
        "Europe",
        "North America",
        "MENA",
        "Africa",
        "LATAM",
        "Global"
      ],
      "default": "Global",
      "title": "Target Region"
    },
    "service": {
      "type": "string",
      "enum": [
        "Data Centre Deployment",
        "Network Deployment",
        "Field Support",
        "Dedicated Engineering Teams",
        "Multiple"
      ],
      "default": "Multiple",
      "title": "Service of Interest"
    },
    "scope": {
      "type": "string",
      "title": "Project Scope",
      "description": "Brief description of the engagement"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "qualified",
        "partnered"
      ],
      "default": "new",
      "title": "Status"
    }
  },
  "required": [
    "company",
    "contact_name",
    "email"
  ]
}