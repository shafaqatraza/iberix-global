# Hosting mode (pick one):
#   base44        — uses the Base44 platform (default, leave blank)
#   independent   — uses your own backend at VITE_API_URL
#   frontend-only — no backend, form submissions emailed via Web3Forms
# VITE_HOSTING_MODE=base44

# Independent backend URL (only needed if VITE_HOSTING_MODE=independent)
# VITE_API_URL=http://localhost:3001/api

# Web3Forms key (only needed if VITE_HOSTING_MODE=frontend-only)
# Get a free key at https://web3forms.com
# VITE_WEB3FORMS_KEY=YOUR_ACCESS_KEY_HERE