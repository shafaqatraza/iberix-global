# Frontend environment variables
# Point this at your backend (runs on port 3001 by default)
VITE_API_URL=http://localhost:3001/api

# ── Frontend-only mode (optional) ──────────────────────────
# To run without any backend/database, set VITE_FRONTEND_ONLY=true
# and provide a Web3Forms key. Form submissions will be emailed
# to you directly — no backend needed.
# See src/deploy-frontend-only.sh for the frontend-only deploy.
# VITE_FRONTEND_ONLY=true
# VITE_WEB3FORMS_KEY=YOUR_ACCESS_KEY_HERE