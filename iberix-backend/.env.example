# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
PORT=3001

# JWT secret — change to a long random string for production
JWT_SECRET=change-this-to-a-long-random-secret

# ─────────────────────────────────────────────
# Ops Console (admin dashboard)
# ─────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_OTP_EMAIL=admin@iberix.global

# ─────────────────────────────────────────────
# Email (SMTP)
# Leave SMTP_HOST blank to print emails to the console instead of sending.
# Configure these for production email delivery.
# ─────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@iberix.global

# ─────────────────────────────────────────────
# File uploads
# ─────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ─────────────────────────────────────────────
# Database (SQLite — stored as a file, no setup needed)
# ─────────────────────────────────────────────
DB_PATH=./data/iberix.db