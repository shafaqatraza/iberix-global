# ─── Frontend (Vite) ──────────────────────────────────────────
# API base URL for the independent backend (leave empty for Base44 hosting)
VITE_API_URL=

# ─── Admin Console (Ops Console at /ops-console) ──────────────
# Set these in Base44 Dashboard → Settings → Environment Variables
# OR in your backend .env for independent hosting
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_OTP_EMAIL=

# ─── Backend (Independent Hosting) ────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/iberix
JWT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@your-domain.com

# ─── File Storage (optional, if using S3) ─────────────────────
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=